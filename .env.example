# Copy to .env and fill in. Everything is optional for local testing.
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string
DATA_DIR=./data

# First-run admin account
ADMIN_EMAIL=admin@canado.ca
ADMIN_PASSWORD=

# Fees and payouts
FEE_BPS=300                 # 300 = 3% final value fee
FEE_ON_SHIPPING=true        # fee applies to item price + shipping (never tax)
HOLD_DAYS=2                 # established sellers: days after payment before funds are available
NEW_SELLER_SALES=5          # completed sales before a seller counts as established
NEW_SELLER_HOLD_DAYS=7      # new sellers: days after tracking is added
AUTO_APPROVE_SELLERS=false

# Stripe (real payments and bank payouts). Leave blank for test mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Canada Post rating API (live rates). Leave blank for built-in estimates.
CANADAPOST_API_USER=
CANADAPOST_API_PASSWORD=
CANADAPOST_CUSTOMER_NUMBER=
CANADAPOST_ENV=development   # or production
